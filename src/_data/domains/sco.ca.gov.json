{
  "$schema": "./../../schemas/domain-scan.schema.json",
  "domain": "sco.ca.gov",
  "targetURL": "https://www.sco.ca.gov/",
  "www": true,
  "active": true,
  "includeInScan": true,
  "title": "SCO: Home",
  "lastStatus": 200,
  "responseHeaders": {
    "connection": "keep-alive",
    "content-encoding": "gzip",
    "content-type": "text/html",
    "expect-ct": "max-age=86400, enforce",
    "referrer-policy": "same-origin",
    "server": "cloudflare",
    "x-content-type-options": "nosniff",
    "x-frame-options": "SAMEORIGIN",
    "x-xss-protection": "1; mode=block"
  },
  "cloudflare": false,
  "slow": false,
  "hasStatewideAlerts": true,
  "usesStateTemplate": true,
  "hasJQuery": false,
  "googleAnalytics": [
    "GTM-5D5F2SV"
  ],
  "socialLinks": [
    "https://twitter.com/CAController",
    "https://www.facebook.com/CAController",
    "https://www.instagram.com/californiacontroller/",
    "https://www.linkedin.com/company/california-state-controllers"
  ],
  "linksToCaGov": false,
  "errorMessage": null,
  "notes": null,
  "nocache": false,
  "goodScan": true,
  "metaAuthor": "State of California : State Controller's Office"
}