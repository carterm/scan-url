{
  "$schema": "./../../schemas/domain-scan.schema.json",
  "domain": "data.ca.gov",
  "targetURL": "https://data.ca.gov/",
  "www": false,
  "active": true,
  "includeInScan": true,
  "title": "California Open Data – Data.CA.gov",
  "lastStatus": 200,
  "responseHeaders": {
    "connection": "keep-alive",
    "content-encoding": "gzip",
    "content-type": "text/html; charset=utf-8",
    "cross-origin-opener-policy": "same-origin",
    "permissions-policy": "camera=(), microphone=(), geolocation=()",
    "referrer-policy": "origin, no-referrer-when-downgrade",
    "server": "hide",
    "x-content-type-options": "nosniff, nosniff",
    "x-frame-options": "SAMEORIGIN",
    "x-nextjs-cache": "HIT",
    "x-permitted-cross-domain-policies": "none",
    "x-static-cache": "BYPASS",
    "x-xss-protection": "1, 1; mode=block"
  },
  "cloudflare": false,
  "slow": false,
  "hasStatewideAlerts": false,
  "usesStateTemplate": false,
  "hasJQuery": false,
  "googleAnalytics": [
    "G-POPULATION",
    "G-YZK8JCN4R2"
  ],
  "socialLinks": [],
  "linksToCaGov": true,
  "errorMessage": null,
  "notes": null,
  "nocache": false,
  "goodScan": true
}